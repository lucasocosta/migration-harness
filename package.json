{
  "name": "migration-harness",
  "private": true,
  "version": "0.2.1",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "clean": "node scripts/clean.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:v02": "node scripts/smoke-v02.mjs",
    "test": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "pnpm build && node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "pilot": "pnpm build && node scripts/pilot.mjs",
    "pilot:assistant": "pnpm build && node scripts/pilot-assistant.mjs",
    "e2e:fixture": "node scripts/e2e-fixture.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:portability": "node scripts/check-portability-lint.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "turbo": "^2.5.0",
    "esbuild": "^0.25.0",
    "@angular/core": "20.3.31",
    "@angular/common": "20.3.31",
    "@angular/compiler": "20.3.31",
    "@angular/platform-browser": "20.3.31",
    "rxjs": "^7.8.2",
    "zone.js": "~0.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "license": "UNLICENSED"
}
