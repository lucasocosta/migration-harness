      "required":true,"fixtureRoot":"examples/api-first/fixtures",
      "bindings":{
        "source":{"entryUrl":"http://127.0.0.1:8310/api/customer","steps":[]},
        "target":{"entryUrl":"http://127.0.0.1:8353/api/customer","steps":[]}
      }
